{
  // Ctrl+Shift+B = roda o arquivo atual | Menu: Terminal > Run Task
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Rodar arquivo atual (Python)",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["${file}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "🧪 Rodar testes (pytest)",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["-m", "pytest", "-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "✨ Checar lint (ruff)",
      "type": "shell",
      "command": "${config:python.defaultInterpreterPath}",
      "args": ["-m", "ruff", "check", "."],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "problemMatcher": "$ruff"
    }
  ]
}
